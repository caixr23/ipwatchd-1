<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>deepin</vendor>
  <vendor_url>https://www.deepin.org/</vendor_url>

  <action id="com.deepin.system.IPWatchD.request-ip-conflict-check">
    <description>Request an IP conflict check</description>
    <message>Authentication is required to request an IP conflict check</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>
</policyconfig>
